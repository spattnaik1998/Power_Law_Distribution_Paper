# Copy to .env in the repository root and fill in your own free API keys.
# stacklib.load_keys() reads this file; it accepts NAME=value or NAME: value.
#
# Census    https://api.census.gov/data/key_signup.html
# BEA       https://apps.bea.gov/API/signup/
# BLS       https://data.bls.gov/registrationEngine/
# FRED      https://fredaccount.stlouisfed.org/apikeys

CENSUS=your_census_key_here
BEA=your_bea_key_here
BLS=your_bls_key_here
FRED=your_fred_key_here
